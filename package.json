{
  "name": "age-of-wogawoga",
  "private": true,
  "version": "0.1.0",
  "description": "Age of Wogawoga (와가와가의 시대) — 원시시대 로우폴리 3D 채집·디펜스 (무료 웹게임)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:fast": "vitest run --passWithNoTests --exclude '**/e2e/**' --exclude '**/sim/autoplay.test.ts'",
    "test:envelope": "vitest run tests/sim/autoplay.test.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "difficulty": "WGD_DIFFICULTY=1 vitest run tests/sim/difficulty.report.test.ts"
  },
  "dependencies": {
    "three": "~0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/three": "~0.185.0",
    "typescript": "~5.9.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
